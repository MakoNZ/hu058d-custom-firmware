# HU-058D data exporter configuration
#
# Copy this file to .env.hu058d, fill in the credentials, then protect it:
#
#   cp .env.hu058d.example .env.hu058d
#   chmod 600 .env.hu058d
#
# Never commit .env.hu058d.

GLADYS_URL='http://homepi.lan:8083'
CLOCK_URL='http://192.168.1.40'

# Local Gladys login used by tools/export-hu058d-data.sh to obtain a fresh
# access token. Gladys access tokens are short-lived, so logging in at export
# time is more convenient for repeatable local analysis.
GLADYS_EMAIL='your-gladys-login@example.com'
GLADYS_PASSWORD='your-gladys-password'

# Optional overrides.
DEVICE_NAME='HU058D'
OUTPUT_ROOT='./analysis-data'

# Explicit selectors make the export independent of feature auto-discovery.
GLADYS_FEATURES='mqtt-hu058d-clock-drift,mqtt-hu058d-clock-drift-average,mqtt-hu058d-clock-free-heap,mqtt-hu058d-clock-rssi,mqtt-hu058d-clock-uptime'

# Request effectively unaggregated stored states from Gladys for practical
# analysis windows. Confirm count_value remains 1 in exported data.
MAX_STATES='1000000000000'

# Optional alternative to email/password. A current access token can be used
# instead, but it expires and is therefore less convenient for automation.
# GLADYS_TOKEN='...'
